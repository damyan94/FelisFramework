{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build_debug",
            "type": "shell",
            "command": "cmake --preset linux-debug && cmake --build --preset linux-debug",
            "group": {
                "kind": "build",
                "cwd": "${workspaceFolder}",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "build_release",
            "type": "shell",
            "command": "cmake --preset linux-release && cmake --build --preset linux-release",
            "group": {
                "kind": "build",
                "cwd": "${workspaceFolder}",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
